  },
  "devDependencies": {
    "@lst/config": "workspace:*",
    "@types/node": "^24.10.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}

{
  "name": "@lst/db",
  "version": "0.1.0",
  "private": true,
  "description": "SERVER-ONLY: Drizzle schema, migrations and DB client",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {

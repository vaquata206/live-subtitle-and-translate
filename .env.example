# Copy to .env (never commit .env). Values below match infra/docker-compose.dev.yml.
DATABASE_URL=postgresql://lst:lst@localhost:5432/lst
REDIS_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025

# apps/web
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000

# apps/realtime
PORT=4000
LOG_LEVEL=info

# Managed AI (phase 4) – server-side only, never exposed to clients
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

{
  "name": "@lst/realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime service: WebSocket ingest from the extension, SSE fan-out to viewers",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsdown src/main.ts --format esm --platform node --target node22 --no-dts --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@lst/entitlements": "workspace:*",
    "@lst/protocol": "workspace:*",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@lst/config": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.0",
    "tsdown": "^0.23.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "ws": "^8.22.1"
  }
}

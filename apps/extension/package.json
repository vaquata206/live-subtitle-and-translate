{
  "name": "@lst/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: live subtitles, translation and meeting minutes for any tab with audio",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@lst/core": "workspace:*"
  },
  "devDependencies": {
    "@lst/config": "workspace:*",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
